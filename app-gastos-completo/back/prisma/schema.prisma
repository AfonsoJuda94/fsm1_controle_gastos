generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Gasto {
  id        String   @id @default(uuid())
  usuario   String
  descricao String
  valor     Float
  categoria String
  data      DateTime @default(now())
}
model Usuario {
  nome String @id
  senha String
}